pragma language_version >= 0.22;

import CompactStandardLibrary;

export enum PoolState { OPEN, LOCKED, SETTLED }

export ledger state: PoolState;
export ledger matchId: Bytes<32>;
export ledger p1Address: Maybe<Bytes<32>>;
export ledger p2Address: Maybe<Bytes<32>>;
export ledger p1Stake: Uint<64>;
export ledger p2Stake: Uint<64>;
export ledger payoutWinner: Maybe<Bytes<32>>;
export ledger treasuryAddress: Bytes<32>;

witness callerAddress(): Bytes<32>;
witness matchIdWitness(): Bytes<32>;

constructor() {
  state = PoolState.OPEN;
  matchId = disclose(matchIdWitness());
  p1Address = none<Bytes<32>>();
  p2Address = none<Bytes<32>>();
  p1Stake = 0;
  p2Stake = 0;
  payoutWinner = none<Bytes<32>>();
  treasuryAddress = disclose(callerAddress());
}

export circuit stakePlayer1(amount: Uint<64>): [] {
  assert(state == PoolState.OPEN, "Pool not open");
  assert(!p1Address.is_some, "Player 1 already staked");
  // In a full implementation, Zswap or token transfers would happen here.
  // For MVP, we record the stake amount.
  p1Address = disclose(some<Bytes<32>>(callerAddress()));
  p1Stake = disclose(amount);
}

export circuit stakePlayer2(amount: Uint<64>): [] {
  assert(state == PoolState.OPEN, "Pool not open");
  assert(!p2Address.is_some, "Player 2 already staked");
  assert(amount == p1Stake, "Must match Player 1 stake");
  
  p2Address = disclose(some<Bytes<32>>(callerAddress()));
  p2Stake = disclose(amount);
  state = PoolState.LOCKED;
}

export circuit settleWinner(winner: Bytes<32>): [] {
  assert(state == PoolState.LOCKED, "Pool not locked");
  const pubWinner = disclose(winner);
  assert(pubWinner == p1Address.value || pubWinner == p2Address.value, "Invalid winner");
  // The backend would verify the win condition proof and settle the pool.
  
  // Calculate Rake Fee (e.g. 5% to treasury)
  // In a full implementation, token transfers would distribute:
  // (TotalPot * 0.95) to winner, (TotalPot * 0.05) to treasuryAddress.
  
  payoutWinner = disclose(some<Bytes<32>>(pubWinner));
  state = PoolState.SETTLED;
}
